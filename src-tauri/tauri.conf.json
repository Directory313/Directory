{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Directory",
  "version": "0.9.5",
  "mainBinaryName": "Directory",
  "identifier": "studio.directory.editor",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Directory Beta",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#101010",
        "dragDropEnabled": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https:; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Directory",
    "category": "Video",
    "shortDescription": "Video editing and motion graphics",
    "longDescription": "Directory Beta: a GPU-accelerated desktop video editor, compositor and motion graphics application.",
    "copyright": "Directory contributors. FFmpeg is licensed under the GPL; see resources/ffmpeg/LICENSE-FFmpeg.txt.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/ffmpeg/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "resources/ffmpeg/ffprobe.exe": "ffmpeg/ffprobe.exe",
      "resources/ffmpeg/LICENSE-FFmpeg.txt": "ffmpeg/LICENSE-FFmpeg.txt",
      "resources/ffmpeg/README-FFmpeg-build.txt": "ffmpeg/README-FFmpeg-build.txt",
      "resources/blender/export_scene.py": "blender/export_scene.py"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MUUyNjEzODU2MTA3QkUKUldTK0IyR0ZFeVllSmFIOTZPVmxEbk52THZvVzhmY29XOS9ValA4UldMV0UrVlRVd1haRWNhaVkK",
      "endpoints": ["https://github.com/Directory313/Directory/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
